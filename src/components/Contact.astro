---
// src/components/Contact.astro
const email = "markryanzipagan3@gmail.com";
---

<section
    id="contact"
    class="relative bg-white text-black px-6 py-24 md:px-16 md:py-32 border-t border-neutral-200"
>
    <span
        data-contact-el
        class="block font-mono text-[11px] tracking-wide text-neutral-400 mb-14 text-center md:text-left"
    >
        08 / contact
    </span>

    <div data-contact-el class="max-w-4xl mx-auto text-center md:text-left">
        <p
            class="text-xl md:text-3xl tracking-tight text-neutral-500 mb-8 max-w-2xl leading-relaxed mx-auto md:mx-0"
        >
            Have a project in mind? Let's build something exceptional together.
        </p>

        <!-- Email link: Added break-all, max-w-full, and responsive text sizing -->
        <a
            href={`mailto:${email}`}
            class="group relative inline-block max-w-full text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-medium tracking-tight text-black pb-4 md:pb-6 break-all"
        >
            {email}
            <!-- Animated underline -->
            <span
                class="absolute bottom-2 md:bottom-3 left-0 h-0.5 md:h-0.75 bg-black w-0 group-hover:w-full transition-all duration-300 ease-out"
            ></span>
        </a>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    const section = document.querySelector<HTMLElement>("#contact");
    const els = section
        ? gsap.utils.toArray<HTMLElement>("[data-contact-el]", section)
        : [];

    if (prefersReducedMotion || els.length === 0) {
        gsap.set(els, { opacity: 1, y: 0 });
    } else {
        gsap.set(els, { opacity: 0, y: 16 });
        gsap.to(els, {
            opacity: 1,
            y: 0,
            duration: 0.7,
            stagger: 0.1,
            ease: "power3.out",
            scrollTrigger: {
                trigger: section,
                start: "top 80%",
                once: true,
            },
        });
    }
</script>

<style>
    [data-contact-el] {
        opacity: 1;
    }
</style>
