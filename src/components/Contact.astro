---
// src/components/Contact.astro
const email = "markryanzipagan3@gmail.com";

const socials = [
    { label: "github", href: "https://github.com/Mrakdatkom" },
    { label: "online jobs ph", href: "https://v2.onlinejobs.ph/jobseekers/info/3463130" },
];

const year = new Date().getFullYear();
---

<section
    id="contact"
    class="relative bg-white text-black px-6 py-24 md:px-16 md:py-32 border-t border-neutral-200"
>
    <span
        data-contact-el
        class="block font-mono text-[11px] tracking-wide text-neutral-400 mb-14"
    >
        08 / contact
    </span>

    <div data-contact-el class="max-w-3xl">
        <p class="text-2xl md:text-4xl tracking-tight text-neutral-500 mb-6">
            Have a project in mind? Let's build something.
        </p>

        <a
            href={`mailto:${email}`}
            data-magnetic
            class="inline-block text-[9vw] sm:text-5xl md:text-6xl lg:text-7xl tracking-tight underline decoration-neutral-300 underline-offset-8 hover:decoration-black transition-colors duration-300"
        >
            {email}
        </a>
    </div>

    <div
        data-contact-el
        class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mt-20 md:mt-28 pt-8 border-t border-neutral-200"
    >
        <div class="flex gap-4 text-sm">
            {
                socials.map((s) => (
                    <a
                        href={s.href}
                        class="hover:opacity-60 transition-opacity"
                    >
                        {s.label} ↗
                    </a>
                ))
            }
        </div>

        <span class="font-mono text-[11px] text-neutral-400">
            © {year} Mark Ryan Zipagan
        </span>

        <a
            href="#hero"
            class="font-mono text-[11px] text-neutral-400 hover:text-black transition-colors duration-200"
        >
            back to top ↑
        </a>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    const section = document.querySelector("#contact");
    const els = section
        ? gsap.utils.toArray<HTMLElement>("[data-contact-el]", section)
        : [];

    if (prefersReducedMotion || els.length === 0) {
        gsap.set(els, { opacity: 1, y: 0 });
    } else {
        gsap.set(els, { opacity: 0, y: 16 });
        gsap.to(els, {
            opacity: 1,
            y: 0,
            duration: 0.6,
            stagger: 0.1,
            ease: "power3.out",
            scrollTrigger: { trigger: section, start: "top 80%", once: true },
        });
    }

    // magnetic hover: only meaningful with a mouse, and skipped for reduced motion
    const magnetic = section?.querySelector<HTMLElement>("[data-magnetic]");
    const hasFinePointer = window.matchMedia("(pointer: fine)").matches;

    if (magnetic && hasFinePointer && !prefersReducedMotion) {
        const strength = 0.25;
        const moveX = gsap.quickTo(magnetic, "x", {
            duration: 0.5,
            ease: "power3.out",
        });
        const moveY = gsap.quickTo(magnetic, "y", {
            duration: 0.5,
            ease: "power3.out",
        });

        magnetic.addEventListener("mousemove", (e) => {
            const rect = magnetic.getBoundingClientRect();
            const relX = e.clientX - (rect.left + rect.width / 2);
            const relY = e.clientY - (rect.top + rect.height / 2);
            moveX(relX * strength);
            moveY(relY * strength);
        });

        magnetic.addEventListener("mouseleave", () => {
            moveX(0);
            moveY(0);
        });
    }
</script>

<style>
    [data-contact-el] {
        opacity: 1;
    }
</style>
