---
// src/components/Contact.astro
const email = "markryanzipagan3@gmail.com";

const socials = [
    { label: "online jobs ph", href: "https://v2.onlinejobs.ph/jobseekers/info/3463130" },
];

const year = new Date().getFullYear();
---

<section
    id="contact"
    class="relative bg-white text-black px-6 py-24 md:px-16 md:py-32 border-t border-neutral-200"
>
    <span
        data-contact-el
        class="block font-mono text-[11px] tracking-wide text-neutral-400 mb-14"
    >
        08 / contact
    </span>

    <div data-contact-el class="max-w-4xl">
        <p class="text-xl md:text-3xl tracking-tight text-neutral-500 mb-8 max-w-2xl leading-relaxed">
            Have a project in mind? Let's build something exceptional together.
        </p>

        <!-- Email link with simple, clean underline hover -->
        <a
            href={`mailto:${email}`}
            class="group relative inline-block text-[10vw] sm:text-6xl md:text-7xl lg:text-8xl font-medium tracking-tight text-black pb-1 md:pb-2"
        >
            {email}
            <!-- Animated underline -->
            <span class="absolute bottom-0 left-0 h-[2px] md:h-[3px] bg-black w-0 group-hover:w-full transition-all duration-300 ease-out"></span>
        </a>
    </div>

    <!-- Footer -->
    <div
        data-contact-el
        class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mt-24 md:mt-32 pt-8 border-t border-neutral-200"
    >
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
            {
                socials.map((s) => (
                    <a
                        href={s.href}
                        class="group relative inline-flex items-center gap-1 text-neutral-500 hover:text-black transition-colors duration-300"
                    >
                        {s.label} 
                        <span class="text-xs">↗</span>
                        <!-- Subtle underline for footer links too -->
                        <span class="absolute -bottom-0.5 left-0 h-px bg-black w-0 group-hover:w-full transition-all duration-300 ease-out"></span>
                    </a>
                ))
            }
        </div>

        <span class="font-mono text-[11px] text-neutral-400 order-3 md:order-2">
            © {year} Mark Ryan Zipagan
        </span>

        <a
            href="#hero"
            class="group order-2 md:order-3 relative inline-flex items-center gap-1.5 font-mono text-[11px] text-neutral-400 hover:text-black transition-colors duration-300"
        >
            <span>↑</span>
            back to top
            <!-- Subtle underline for back to top -->
            <span class="absolute -bottom-0.5 left-0 h-px bg-black w-0 group-hover:w-full transition-all duration-300 ease-out"></span>
        </a>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    const section = document.querySelector<HTMLElement>("#contact");
    const els = section
        ? gsap.utils.toArray<HTMLElement>("[data-contact-el]", section)
        : [];

    if (prefersReducedMotion || els.length === 0) {
        gsap.set(els, { opacity: 1, y: 0 });
    } else {
        gsap.set(els, { opacity: 0, y: 16 });
        gsap.to(els, {
            opacity: 1,
            y: 0,
            duration: 0.7,
            stagger: 0.1,
            ease: "power3.out",
            scrollTrigger: { 
                trigger: section, 
                start: "top 80%", 
                once: true 
            },
        });
    }
</script>

<style>
    [data-contact-el] {
        opacity: 1;
    }
</style>