---
// src/components/Experience.astro
const roles = [
  {
    dates: "Aug 2026 — Present",
    title: "Full-Time IT Instructor",
    company: "Colegio de Sta. Ana de Victorias",
    desc: "Educating and mentoring future tech professionals in Web Development, Computer Networking, Systems Fundamentals, and Business Process Management using hands-on methodologies.",
  },
  {
    dates: "Jul 2026 — Present",
    title: "Co-Founder & Full-Stack Developer",
    company: "Neo Creatives",
    desc: "Co-leading a software studio delivering custom company websites, business management systems, and web applications for startup clients and growing businesses.",
  },
  {
    dates: "Jun 2026 — Present",
    title: "Web Developer",
    company: "iProcess",
    desc: "Developed a top-performing, modern company website from scratch that loads instantly, ranks high on search engines, and delivers a smooth user experience across all devices.",
  },
  {
    dates: "Feb 2026 — May 2026",
    title: "Web Developer Intern",
    company: "Warlen Industrial Sales Corporation",
    desc: "Built a fast attendance system in Laravel & React that easily handles thousands of employee records, speeds up page loading, and features a clean design that works seamlessly on mobile and desktop.",
  },
];
---

<section
    id="work"
    class="relative bg-white text-black px-6 py-24 md:px-16 md:py-32 border-t border-neutral-200"
>
    <span
        data-exp-el
        class="block font-mono text-[11px] tracking-wide text-neutral-400 mb-14 text-center md:text-left"
    >
        04 / experience
    </span>

    <!-- Centered Container -->
    <div class="relative max-w-4xl mx-auto">
        <!-- Continuous vertical line, drawn in on scroll -->
        <!-- FIXED: Changed invalid 'left-2.25' to valid arbitrary value 'left-[9px]' -->
        <div
            data-exp-line
            class="absolute left-2.25 md:left-1/4 top-0 bottom-0 w-px bg-neutral-200 origin-top scale-y-0"
        ></div>

        <div class="space-y-0">
            {
                roles.map((r) => (
                    <div
                        data-exp-row
                        class="relative flex flex-col sm:flex-row gap-3 sm:gap-4 md:gap-0 py-6 sm:py-8 border-b border-neutral-100 last:border-0 group cursor-default pl-8 md:pl-0"
                    >
                        <!-- Timeline Marker -->
                        <div
                            data-exp-node
                            class="absolute left-0.75 sm:left-[calc(16.666%-7px)] md:left-[calc(25%-7px)] top-6 sm:top-8 md:top-8.5 w-3 h-3 sm:w-3.5 sm:h-3.5 rounded-full border-2 border-neutral-300 bg-white z-10 transition-all duration-300 group-hover:border-black group-hover:scale-125 group-hover:bg-neutral-100"
                            aria-hidden="true"
                        ></div>

                        <!-- Date Column -->
                        <div class="w-full sm:w-1/3 md:w-1/4 md:pr-8 lg:pr-10 md:text-right mb-1 sm:mb-0">
                            <span class="inline-block font-mono text-[10px] sm:text-[11px] tracking-widest text-neutral-400 uppercase bg-neutral-50 px-2 sm:px-3 py-1 sm:py-1.5 rounded-full border border-neutral-100 group-hover:border-neutral-300 group-hover:text-neutral-600 transition-colors duration-300 whitespace-nowrap">
                                {r.dates}
                            </span>
                        </div>
                        
                        <!-- Content Column -->
                        <div class="w-full sm:w-2/3 md:w-3/4 md:pl-6 lg:pl-10">
                            <h3 class="text-lg sm:text-xl md:text-2xl font-semibold tracking-tight text-black transition-colors duration-300 group-hover:text-neutral-800">
                                {r.company}
                            </h3>
                            <p class="text-sm font-medium text-neutral-500 mt-1.5 mb-3 flex items-center gap-2">
                                {r.title}
                            </p>
                            <p class="text-[14px] sm:text-[15px] text-neutral-600 leading-relaxed max-w-xl">
                                {r.desc}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    const section = document.querySelector<HTMLElement>("#work");
    const label = section?.querySelector<HTMLElement>("[data-exp-el]");
    const line = section?.querySelector<HTMLElement>("[data-exp-line]");
    const rows = section
        ? gsap.utils.toArray<HTMLElement>("[data-exp-row]", section)
        : [];

    if (prefersReducedMotion || rows.length === 0) {
        gsap.set([label, line, ...rows], { opacity: 1, y: 0, scaleY: 1 });
        rows.forEach((row) => {
            const node = row.querySelector<HTMLElement>("[data-exp-node]");
            if (node) gsap.set(node, { scale: 1, borderColor: "#d4d4d4" });
        });
    } else {
        if (label) {
            gsap.set(label, { opacity: 0, y: 12 });
        }
        gsap.set(rows, { opacity: 0, y: 24 });
        gsap.set("[data-exp-node]", { scale: 0, borderColor: "#d4d4d4" });

        if (label) {
            gsap.to(label, {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: section,
                    start: "top 80%",
                    once: true,
                },
            });
        }

        // Line draws in proportionally to scroll
        if (line) {
            gsap.to(line, {
                scaleY: 1,
                ease: "none",
                scrollTrigger: {
                    trigger: section,
                    start: "top 70%",
                    end: "bottom 60%",
                    scrub: 0.6,
                },
            });
        }

        // Animate each row and its marker
        rows.forEach((row, i) => {
            const node = row.querySelector<HTMLElement>("[data-exp-node]");

            // Row fade/slide up
            gsap.to(row, {
                opacity: 1,
                y: 0,
                duration: 0.7,
                ease: "power3.out",
                scrollTrigger: { 
                    trigger: row, 
                    start: "top 85%", 
                    once: true 
                },
            });

            // Marker pop-in with a slight delay after the row starts appearing
            if (node) {
                gsap.to(node, {
                    scale: 1,
                    duration: 0.5,
                    ease: "back.out(2.5)",
                    scrollTrigger: {
                        trigger: row,
                        start: "top 85%",
                        once: true,
                    },
                    delay: 0.15, // Stagger the dot slightly after the text
                });
            }
        });
    }
</script>

<style>
    [data-exp-el] {
        opacity: 1;
    }
</style>