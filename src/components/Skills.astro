---
// src/components/Skills.astro

import js from "../assets/skills/javascript.svg";
import ts from "../assets/skills/typescript.svg";
import react from "../assets/skills/react.svg";
import astro from "../assets/skills/astro.svg";
import tailwind from "../assets/skills/tailwindcss.svg";
import gsap from "../assets/skills/gsap.svg";
import express from "../assets/skills/express.svg";
import laravel from "../assets/skills/laravel.svg";
import html from "../assets/skills/html.svg";
import vercel from "../assets/skills/vercel.svg";
import googlesheets from "../assets/skills/googlesheets.svg";

import figma from "../assets/skills/figma.svg";
import git from "../assets/skills/git.svg";
import github from "../assets/skills/github.svg";
import vite from "../assets/skills/vite.svg";
import postgresql from "../assets/skills/postgresql.svg";
import postman from "../assets/skills/postman.svg";
import mysql from "../assets/skills/mysql.svg";
import php from "../assets/skills/php.svg";
import bootstrap from "../assets/skills/bootstrap.svg";
import css from "../assets/skills/css.svg";
import googlecalendar from "../assets/skills/googlecalendar.svg"
import { Image } from "astro:assets";

const rowA = [
    {name: "JavaScript", icon: js},
    {name: "TypeScript", icon: ts},
    {name: "React", icon: react},
    {name: "Astro", icon: astro},
    {name: "Tailwind", icon: tailwind},
    {name: "GSAP", icon: gsap},
    {name: "Express", icon: express},
    {name: "Laravel", icon: laravel},
    {name: "HTML", icon: html},
    {name: "Vercel", icon: vercel},
    {name: "Google Sheets", icon: googlesheets},
];

const rowB = [
    {name: "Figma", icon: figma},
    {name: "Git", icon: git},
    {name: "Github", icon: github},
    {name: "Vite", icon: vite},
    {name: "PostgreSQL", icon: postgresql}, 
    {name: "Postman", icon: postman}, 
    {name: "MySQL", icon: mysql},
    {name: "PHP", icon: php},
    {name: "Boostrap", icon: bootstrap},
    {name: "CSS", icon: css},
    {name: "Google Calendar", icon: googlecalendar},
];
---

<section
    id="skills"
    class="relative bg-white text-black py-24 md:py-32 border-t border-neutral-200"
>
    <span
        data-skills-el
        class="block font-mono text-[11px] tracking-wide text-neutral-400 mb-14 px-6 md:px-16"
    >
        03 / skills
    </span>

    <div class="space-y-6 md:space-y-8">
        <!-- Row A -->
        <div class="relative border-y border-neutral-200 py-4 md:py-6 overflow-hidden mask-[linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
            <div
                data-marquee-track="a"
                class="flex w-max items-center gap-8 md:gap-12 cursor-default"
            >
                {
                    [...rowA, ...rowA].map((skill) => (
                        <span class="flex items-center gap-3 md:gap-4 text-3xl md:text-5xl tracking-tight text-black select-none">
                            <!-- Image/Icon Placeholder -->
                            <span class="inline-flex items-center justify-center w-8 h-8 md:w-10 md:h-10 bg-neutral-100 rounded-full shrink-0 overflow-hidden">
                                <img 
                                    src={skill.icon.src} 
                                    alt={skill.name}
                                    class="w-5 h-5 md:w-6 md:h-6 object-contain"
                                    loading="lazy"
                                />
                            </span>
                            {skill.name}
                            <span class="text-neutral-300" aria-hidden="true">/</span>
                        </span>
                    ))
                }
            </div>
        </div>

        <!-- Row B -->
        <div class="relative border-b border-neutral-200 py-4 md:py-6 overflow-hidden mask-[linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
            <div
                data-marquee-track="b"
                class="flex w-max items-center gap-8 md:gap-12 cursor-default"
            >
                {
                    [...rowB, ...rowB].map((skill) => (
                        <span class="flex items-center gap-3 md:gap-4 text-3xl md:text-5xl tracking-tight text-neutral-400 select-none">
                            <!-- Image/Icon Placeholder -->
                            <span class="inline-flex items-center justify-center w-8 h-8 md:w-10 md:h-10  bg-neutral-100 rounded-full shrink-0 overflow-hidden">
                                <img 
                                    src={skill.icon.src} 
                                    alt={skill.name}
                                    class="w-5 h-5 md:w-6 md:h-6 object-contain"
                                    loading="lazy"
                                />
                            </span>
                            {skill.name}
                            <span class="text-neutral-200" aria-hidden="true">/</span>
                        </span>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const trackA = document.querySelector<HTMLElement>('[data-marquee-track="a"]');
    const trackB = document.querySelector<HTMLElement>('[data-marquee-track="b"]');
    const label = document.querySelector<HTMLElement>("[data-skills-el]");
    
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // 1. Label animation
    if (label) {
        gsap.set(label, { opacity: prefersReducedMotion ? 1 : 0, y: prefersReducedMotion ? 0 : 12 });
        if (!prefersReducedMotion) {
            gsap.to(label, {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: "#skills",
                    start: "top 80%",
                    once: true,
                },
            });
        }
    }

    // 2. Marquee logic with seamless loop AND hover pause
    function initMarquee(track: HTMLElement | null, direction: 1 | -1, duration: number) {
        if (!track || prefersReducedMotion) return;

        // direction 1 = moves left (0% to -50%)
        // direction -1 = moves right (-50% to 0%)
        const startX = direction === 1 ? 0 : -50;
        const endX = direction === 1 ? -50 : 0;

        gsap.set(track, { xPercent: startX });

        // Store the tween instance so we can control its timeScale
        const tween = gsap.to(track, {
            xPercent: endX,
            duration: duration,
            ease: "none",
            repeat: -1,
        });

        // Smoothly pause on hover
        track.addEventListener("mouseenter", () => {
            gsap.to(tween, { timeScale: 0, duration: 0.4, ease: "power2.out" });
        });

        // Smoothly resume on leave
        track.addEventListener("mouseleave", () => {
            gsap.to(tween, { timeScale: 1, duration: 0.4, ease: "power2.out" });
        });
    }

    initMarquee(trackA, 1, 25);
    initMarquee(trackB, -1, 30);
</script>

<style>
    [data-skills-el] {
        opacity: 1;
    }
</style>