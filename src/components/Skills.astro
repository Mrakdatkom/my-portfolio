// src/components/Skills.astro (Combined with Activity)

// 1. Import SVGs as inline components () to preserve original colors
import js from "../assets/skills/javascript.svg";
import ts from "../assets/skills/typescript.svg";
import react from "../assets/skills/react.svg";
import astro from "../assets/skills/astro.svg";
import tailwind from "../assets/skills/tailwindcss.svg";
import gsap from "../assets/skills/gsap.svg";
import express from "../assets/skills/express.svg";
import laravel from "../assets/skills/laravel.svg";
import html from "../assets/skills/html.svg";
import vercel from "../assets/skills/vercel.svg";
import googlesheets from "../assets/skills/googlesheets.svg";
import googlecalendar from "../assets/skills/googlecalendar.svg";

import figma from "../assets/skills/figma.svg";
import git from "../assets/skills/git.svg";
import github from "../assets/skills/github.svg";
import vite from "../assets/skills/vite.svg";
import postgresql from "../assets/skills/postgresql.svg";
import postman from "../assets/skills/postman.svg";
import mysql from "../assets/skills/mysql.svg";
import php from "../assets/skills/php.svg";
import bootstrap from "../assets/skills/bootstrap.svg";
import css from "../assets/skills/css.svg";
import vscode from "../assets/skills/vscode.svg";
import wordpress from "../assets/skills/wordpress.svg";

// 2. Group skills logically by use-case
const skillCategories = [
    {
        title: "Frontend",
        skills: [
            { name: "JavaScript", icon: js },
            { name: "TypeScript", icon: ts },
            { name: "React", icon: react },
            { name: "Astro", icon: astro },
            { name: "Tailwind CSS", icon: tailwind },
            { name: "GSAP", icon: gsap },
            { name: "HTML5", icon: html },
            { name: "CSS3", icon: css },
            { name: "Bootstrap", icon: bootstrap },
        ],
    },
    {
        title: "Backend & Database",
        skills: [
            { name: "Express.js", icon: express },
            { name: "Laravel", icon: laravel },
            { name: "PHP", icon: php },
            { name: "PostgreSQL", icon: postgresql },
            { name: "MySQL", icon: mysql },
        ],
    },
    {
        title: "Tools & Workflow",
        skills: [
            { name: "Git", icon: git },
            { name: "GitHub", icon: github },
            { name: "Vite", icon: vite },
            { name: "Vercel", icon: vercel },
            { name: "Figma", icon: figma },
            { name: "Postman", icon: postman },
            { name: "Google Sheets", icon: googlesheets },
            { name: "Google Calendar", icon: googlecalendar },
            { name: "Visual Studio Code", icon: vscode },
            { name: "WordPress", icon: wordpress },
        ],
    },
];

// 3. GitHub Activity Data
const GITHUB_USERNAMES = ["Mrakdatkom", "markryan3421"];
const token = import.meta.env.GITHUB_TOKEN;

type Day = { date: string; count: number };
type WeekData = Day[];

let weeks: WeekData[] = [];
let combinedTotal = 0;
let fetchFailed = false;

const queryVariables: Record<string, string> = {};
const queryFields = GITHUB_USERNAMES.map((username, index) => {
    queryVariables[`login${index}`] = username;
    return `
      user${index}: user(login: $login${index}) {
        contributionsCollection {
          contributionCalendar {
            totalContributions
            weeks {
              contributionDays {
                date
                contributionCount
              }
            }
          }
        }
      }
    `;
}).join("\n");

const query = `
  query (${GITHUB_USERNAMES.map((_, i) => `$login${i}: String!`).join(", ")}) {
    ${queryFields}
  }
`;

if (token) {
    try {
        const res = await fetch("https://api.github.com/graphql", {
            method: "POST",
            headers: {
                Authorization: `bearer ${token}`,
                "Content-Type": "application/json",
            },
            body: JSON.stringify({ query, variables: queryVariables }),
        });

        if (!res.ok) throw new Error(`GitHub API responded ${res.status}`);

        const json = await res.json();
        const baseCalendar = json?.data?.user0?.contributionsCollection?.contributionCalendar;

        if (!baseCalendar) throw new Error("Unexpected GraphQL response shape");

        weeks = baseCalendar.weeks.map((week: any, weekIndex: number) => {
            return week.contributionDays.map((day: any) => {
                let dailyCount = day.contributionCount;

                for (let i = 1; i < GITHUB_USERNAMES.length; i++) {
                    const otherCalendar = json?.data?.[`user${i}`]?.contributionsCollection?.contributionCalendar;
                    if (otherCalendar) {
                        const otherDay = otherCalendar.weeks[weekIndex].contributionDays.find((d: any) => d.date === day.date);
                        if (otherDay) dailyCount += otherDay.contributionCount;
                    }
                }

                combinedTotal += dailyCount;
                return { date: day.date, count: dailyCount };
            });
        });
    } catch (err) {
        console.error("[Skills.astro] Failed to fetch GitHub data:", err);
        fetchFailed = true;
    }
} else {
    console.warn("[Skills.astro] GITHUB_TOKEN not set — rendering placeholder data.");
    fetchFailed = true;
}

if (fetchFailed || weeks.length === 0) {
    weeks = Array.from({ length: 52 }, () =>
        Array.from({ length: 7 }, () => ({
            date: "",
            count: Math.random() < 0.35 ? 0 : Math.floor(Math.random() * 10),
        }))
    );
    combinedTotal = weeks.flat().reduce((sum, d) => sum + d.count, 0);
}

function getHeightLevel(count: number, max: number) {
    if (count === 0) return 1;
    const ratio = count / Math.max(max, 1);
    if (ratio < 0.25) return 2;
    if (ratio < 0.5) return 3;
    if (ratio < 0.75) return 4;
    return 5;
}

const maxCount = Math.max(...weeks.flat().map((d) => d.count), 1);
const opacityScale = [0.15, 0.3, 0.5, 0.75, 1];

// 1. Define a stric 3-letter month array
const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

// 2. Use the array to guarantee exactly 3 letters
const monthLabels = weeks.map((week, i) => {
    if (!week[0]?.date) return "";
    const date = new Date(week[0].date);
    const prevDate = i > 0 && weeks[i - 1][0]?.date ? new Date(weeks[i - 1][0].date) : null;
    const isNewMonth = !prevDate || date.getMonth() !== prevDate.getMonth();
    
    // Return the 3-letter string from our array, or empty string
    return isNewMonth ? monthNames[date.getMonth()] : "";
});
---

<!-- COMBINED SECTION -->
<section
    id="skills"
    class="relative bg-white text-black px-6 py-24 md:px-16 md:py-32 border-t border-neutral-200"
>
    <!-- Main Section Label -->
    <span
        data-skills-el
        class="block font-mono text-[11px] tracking-wide text-neutral-400 mb-14 text-center md:text-left"
    >
        03 / skills & activity
    </span>

    <!-- PART 1: SKILLS GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 md:gap-12 max-w-6xl mx-auto mb-24 md:mb-32">
        {
            skillCategories.map((category) => (
                <div data-skill-category class="flex flex-col items-center md:items-start">
                    <h3 class="font-mono text-xs tracking-widest text-neutral-400 uppercase mb-5 pb-3 border-b border-neutral-200 w-full text-center md:text-left">
                        {category.title}
                    </h3>

                    <!-- Badges Container -->
                    <div class="flex flex-wrap gap-3 justify-center md:justify-start">
                        {
                            category.skills.map((skill) => {
                                const Icon = skill.icon;
                                return (
                                    <div
                                        data-skill-badge
                                        class="inline-flex items-center gap-2.5 px-3.5 py-2 rounded-xl border border-neutral-200 bg-neutral-50 text-sm font-medium text-neutral-700 cursor-default"
                                    >
                                        <Icon class="w-4 h-4 md:w-5 md:h-5 shrink-0" />
                                        <span>{skill.name}</span>
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>
            ))
        }
    </div>

    <!-- Visual Divider -->
    <div class="max-w-4xl mx-auto border-t border-neutral-200 mb-24 md:mb-32"></div>

    <!-- PART 2: ACTIVITY GRAPH -->
    <div id="activity" class="flex flex-col items-center w-full">
        <span
            data-activity-el
            class="block font-mono text-[11px] tracking-wide text-neutral-400 mb-6 text-center"
        >
            github contributions
        </span>

        <div class="flex flex-col items-center mb-8 max-w-3xl w-full px-6">
            <p class="text-sm text-neutral-500 mb-2 text-center">
                {combinedTotal.toLocaleString()} combined contributions in the last year
            </p>
            <a
                href={`https://github.com/Mrakdatkom`}
                class="text-sm border-b border-black pb-0.5 inline-block hover:opacity-60 transition-opacity"
            >
                view primary github ↗
            </a>
        </div>

        <div class="sm:hidden flex flex-col items-center w-full px-4">
            <!-- Month Labels for Mobile -->
            <div class="grid mb-1 w-full max-w-md" style="grid-template-columns: repeat(26, 1fr); gap: 2px;">
                {
                    monthLabels.slice(-26).map((label) => (
                        <span class="font-mono text-[8px] text-neutral-400 h-3 text-center">
                            {label}
                        </span>
                    ))
                }
            </div>

            <!-- Soundwave Grid for Mobile -->
            <div
                data-activity-grid-mobile
                class="grid items-end w-full max-w-md"
                style="grid-template-rows: 2rem; grid-auto-columns: minmax(8px, 1fr); grid-auto-flow: column; gap: 3px; min-height: 2rem;"
            >
                {
                    weeks.slice(-4).map((week) =>
                        week.map((day) => {
                            const level = getHeightLevel(day.count, maxCount);
                            // Mobile-specific heights
                            const heightMap = [6, 10, 16, 22, 30]; 
                            const barHeight = heightMap[level - 1] || 6;
                            
                            return (
                                <div
                                    data-activity-bar-mobile
                                    class="w-full rounded-t-sm"
                                    style={{
                                        backgroundColor: `rgba(0, 0, 0, ${opacityScale[level]})`,
                                        height: `${barHeight}px`,
                                        minHeight: '4px',
                                        transformOrigin: "bottom",
                                        display: 'block',
                                        visibility: 'visible',
                                    }}
                                    title={day.date ? `${day.count} combined contributions on ${day.date}` : undefined}
                                />
                            );
                        })
                    )
                }
            </div>
        </div>

        <div class="hidden sm:flex flex-col items-center w-full px-4">
            <!-- Month Labels for Desktop -->
            <div class="grid mb-2 w-full max-w-3xl" style={`grid-template-columns: repeat(${weeks.length}, 1fr); gap: 1px;`}>
                {
                    monthLabels.map((label) => (
                        <span class="font-mono text-[8px] md:text-[9px] text-neutral-400 h-3 text-center">
                            {label}
                        </span>
                    ))
                }
            </div>

            <!-- Soundwave Grid for Desktop -->
            <div
                data-activity-grid-desktop
                class="grid items-end w-full max-w-3xl"
                style={`grid-template-rows: 2rem; grid-auto-columns: 1fr; grid-auto-flow: column; gap: 1px; min-height: 2rem;`}
            >
                {
                    weeks.map((week) =>
                        week.map((day) => {
                            const level = getHeightLevel(day.count, maxCount);
                            const heightMap = [4, 8, 14, 20, 28];
                            const barHeight = heightMap[level - 1] || 4;
                            
                            return (
                                <div
                                    data-activity-bar-desktop
                                    class="w-full rounded-t-sm"
                                    style={{
                                        backgroundColor: `rgba(0, 0, 0, ${opacityScale[level]})`,
                                        height: `${barHeight}px`,
                                        minHeight: '3px',
                                        transformOrigin: "bottom",
                                        display: 'block',
                                        visibility: 'visible',
                                    }}
                                    title={day.date ? `${day.count} combined contributions on ${day.date}` : undefined}
                                />
                            );
                        })
                    )
                }
            </div>
        </div>

        <!-- Legend (Shared) -->
        <div class="flex items-center justify-center gap-1.5 sm:gap-2 md:gap-3 mt-6 font-mono text-[8px] sm:text-[9px] md:text-[10px] text-neutral-400">
            <span>less</span>
            <div class="flex items-end gap-1 sm:gap-2 h-8">
                {
                    [4, 8, 14, 20, 28].map((height, i) => (
                        <div
                            class="w-1 sm:w-1.5 rounded-t-sm"
                            style={{ 
                                backgroundColor: `rgba(0, 0, 0, ${opacityScale[i]})`,
                                height: `${height}px`
                            }}
                        />
                    ))
                }
            </div>
            <span>more</span>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    const section = document.querySelector<HTMLElement>("#skills");
    const skillsLabel = section?.querySelector<HTMLElement>("[data-skills-el]");
    const categories = section ? gsap.utils.toArray<HTMLElement>("[data-skill-category]", section) : [];
    const badges = section ? gsap.utils.toArray<HTMLElement>("[data-skill-badge]", section) : [];

    const activityLabel = section?.querySelector<HTMLElement>("[data-activity-el]");
    
    // Separate mobile and desktop bars
    const mobileBars = section ? gsap.utils.toArray<HTMLElement>("[data-activity-bar-mobile]", section) : [];
    const desktopBars = section ? gsap.utils.toArray<HTMLElement>("[data-activity-bar-desktop]", section) : [];
    
    // Determine which bars are visible
    const isMobile = window.innerWidth < 640;
    const bars = isMobile ? mobileBars : desktopBars;

    if (prefersReducedMotion) {
        gsap.set([skillsLabel, activityLabel, ...categories, ...badges], { opacity: 1, y: 0 });
        gsap.set([...mobileBars, ...desktopBars], { opacity: 1, scaleY: 1 });
    } else {
        // --- Skills Animation ---
        if (skillsLabel) gsap.set(skillsLabel, { opacity: 0, y: 12 });
        gsap.set(categories, { opacity: 0, y: 20 });
        gsap.set(badges, { opacity: 0, y: 10, scale: 0.95 });

        if (skillsLabel) {
            gsap.to(skillsLabel, {
                opacity: 1, y: 0, duration: 0.6, ease: "power3.out",
                scrollTrigger: { trigger: section, start: "top 85%", once: true },
            });
        }

        gsap.to(categories, {
            opacity: 1, y: 0, duration: 0.7, stagger: 0.15, ease: "power3.out",
            scrollTrigger: { trigger: section, start: "top 80%", once: true },
        });

        gsap.to(badges, {
            opacity: 1, y: 0, scale: 1, duration: 0.5, stagger: 0.03, ease: "back.out(1.5)",
            scrollTrigger: { trigger: section, start: "top 75%", once: true },
        });

        // --- Activity Animation ---
        if (activityLabel) {
            gsap.set(activityLabel, { opacity: 0, y: 12 });
            gsap.to(activityLabel, {
                opacity: 1, y: 0, duration: 0.6, ease: "power3.out",
                scrollTrigger: { trigger: "#activity", start: "top 85%", once: true },
            });
        }

        // Animate visible bars
        if (bars.length > 0) {
            gsap.set(bars, { scaleY: 0 });
            gsap.to(bars, {
                scaleY: 1, 
                duration: 0.6, 
                ease: "power2.out", 
                stagger: { each: 0.005, from: "start" },
                scrollTrigger: { 
                    trigger: "#activity", 
                    start: "top 85%", 
                    once: true 
                },
                onComplete: () => {
                    // Ensure all bars are visible
                    bars.forEach(bar => {
                        const element = bar as HTMLElement;
                        element.style.transform = 'scaleY(1)';
                        element.style.opacity = '1';
                    });
                }
            });
        }
    }

    // Fallback for mobile: ensure bars are visible after animation
    setTimeout(() => {
        document.querySelectorAll<HTMLElement>('[data-activity-bar-mobile]').forEach(bar => {
            const computedStyle = window.getComputedStyle(bar);
            if (computedStyle.transform === 'none' || computedStyle.transform === 'matrix(1, 0, 0, 1, 0, 0)') {
                bar.style.transform = 'scaleY(1)';
                bar.style.opacity = '1';
                bar.style.display = 'block';
            }
        });
    }, 1000);
</script>

<style>
    [data-skills-el], [data-activity-el] {
        opacity: 1;
    }

    /* Ensure mobile bars are always visible */
    [data-activity-bar-mobile] {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
        transform: scaleY(1) !important;
    }

    [data-activity-bar-desktop] {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
        transform: scaleY(1) !important;
    }

    /* Mobile grid fixes */
    @media (max-width: 640px) {
        [data-activity-grid-mobile] {
            min-height: 2rem !important;
            grid-template-rows: 2rem !important;
        }
        
        [data-activity-grid-mobile] > div {
            min-height: 4px !important;
        }
    }
</style>