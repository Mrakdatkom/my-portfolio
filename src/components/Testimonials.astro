---
// src/components/Testimonials.astro
const testimonials = [
    {
        quote: "Mark was one of my most standout students. His grasp of web development and system fundamentals, combined with his ability to explain complex concepts, makes him an exceptional developer and educator.",
        name: "Prof. Noel Revilla",
        role: "Program Head, MIT",
    },
    {
        quote: "Mark turns complicated system ideas into simple, beautiful websites. He’s always my go-to person whenever I need technical advice or collaboration on freelance projects.",
        name: "John David Asuncion",
        role: "Freelance UI/UX Designer & Sales Representative",
    },
    {
        quote: "Mark's patience and systematic approach to teaching data entry transformed my workflow efficiency. His ability to break down complex processes into manageable steps is remarkable.",
        name: "Maria Santos",
        role: "Data Entry Coach",
    },
    {
        quote: "During his internship, Mark and his team built a fast, reliable attendance system that solved real operational headaches for our company. His work ethic, problem-solving skills, and attention to detail are top-tier.",
        name: "Engr. Warlito Dato-on",
        role: "Company President, Warlen Industrial Sales Corp.",
    },
    {
        quote: "Mark developed a high-performance website for our company from scratch. He delivered exceptional speed, seamless search engine optimization, and complete professionalism throughout the entire project.",
        name: "Calvert Chavez",
        role: "President, iProcess",
    },
    {
        quote: "Working alongside Mark on complex web projects made everything so much easier. He is super reliable, always ready to help debug issues, and writes clean code that just works.",
        name: "Aedrian Pesca",
        role: "Co-Intern & Full Stack Developer",
    },
];

// Manually split the array into 3 columns to force a perfect 2-2-2 layout
const col1 = testimonials.slice(0, 2);
const col2 = testimonials.slice(2, 4);
const col3 = testimonials.slice(4, 6);
---

<section
    id="testimonials"
    class="relative bg-white text-black px-6 py-24 md:px-16 md:py-32 border-t border-neutral-200"
>
    <span
        data-testi-el
        class="block font-mono text-[11px] tracking-wide text-neutral-400 mb-14 text-center md:text-left"
    >
        06 / testimonials
    </span>

    <!-- Grid Layout with 3 Manual Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        <!-- Column 1 -->
        <div class="flex flex-col gap-6 md:gap-8">
            {
                col1.map((t) => (
                    <div
                        data-testi-card
                        class="relative bg-neutral-50 border border-neutral-200 p-6 md:p-8 rounded-2xl"
                    >
                        <span class="block text-4xl md:text-5xl text-neutral-200 font-serif leading-none mb-2 select-none">
                            “
                        </span>
                        <p class="text-lg md:text-xl leading-relaxed text-neutral-800 mb-6">
                            {t.quote}
                        </p>
                        <div class="border-t border-neutral-200 pt-4">
                            <p class="font-semibold text-black text-sm">
                                {t.name}
                            </p>
                            <p class="font-mono text-[11px] text-neutral-400 mt-1 uppercase tracking-wide">
                                {t.role}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- Column 2 -->
        <div class="flex flex-col gap-6 md:gap-8">
            {
                col2.map((t) => (
                    <div
                        data-testi-card
                        class="relative bg-neutral-50 border border-neutral-200 p-6 md:p-8 rounded-2xl"
                    >
                        <span class="block text-4xl md:text-5xl text-neutral-200 font-serif leading-none mb-2 select-none">
                            “
                        </span>
                        <p class="text-lg md:text-xl leading-relaxed text-neutral-800 mb-6">
                            {t.quote}
                        </p>
                        <div class="border-t border-neutral-200 pt-4">
                            <p class="font-semibold text-black text-sm">
                                {t.name}
                            </p>
                            <p class="font-mono text-[11px] text-neutral-400 mt-1 uppercase tracking-wide">
                                {t.role}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- Column 3 -->
        <div class="flex flex-col gap-6 md:gap-8">
            {
                col3.map((t) => (
                    <div
                        data-testi-card
                        class="relative bg-neutral-50 border border-neutral-200 p-6 md:p-8 rounded-2xl"
                    >
                        <span class="block text-4xl md:text-5xl text-neutral-200 font-serif leading-none mb-2 select-none">
                            “
                        </span>
                        <p class="text-lg md:text-xl leading-relaxed text-neutral-800 mb-6">
                            {t.quote}
                        </p>
                        <div class="border-t border-neutral-200 pt-4">
                            <p class="font-semibold text-black text-sm">
                                {t.name}
                            </p>
                            <p class="font-mono text-[11px] text-neutral-400 mt-1 uppercase tracking-wide">
                                {t.role}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    const section = document.querySelector<HTMLElement>("#testimonials");
    const label = section?.querySelector<HTMLElement>("[data-testi-el]");
    const cards = section
        ? gsap.utils.toArray<HTMLElement>("[data-testi-card]", section)
        : [];

    if (prefersReducedMotion || cards.length === 0) {
        gsap.set([label, ...cards], { opacity: 1, y: 0 });
    } else {
        if (label) {
            gsap.set(label, { opacity: 0, y: 12 });
        }
        gsap.set(cards, { opacity: 0, y: 30 });

        if (label) {
            gsap.to(label, {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: section,
                    start: "top 85%",
                    once: true,
                },
            });
        }

        gsap.to(cards, {
            opacity: 1,
            y: 0,
            duration: 0.7,
            stagger: 0.1,
            ease: "power3.out",
            scrollTrigger: {
                trigger: section,
                start: "top 80%",
                once: true,
            },
        });
    }
</script>

<style>
    [data-testi-el] {
        opacity: 1;
    }
</style>
