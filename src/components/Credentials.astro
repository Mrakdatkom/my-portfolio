---
// src/components/Credentials.astro

// 1. Define a strict type to fix the TypeScript error
interface Credential {
    date: string;
    title: string;
    subtitle: string;
    about?: string; // Optional property
}

const data: Record<string, Credential[]> = {
    education: [
        {
            date: "Aug 2022 — Jun 2026",
            title: "BS in Information Systems",
            subtitle: "Colegio de Sta. Ana de Victorias",
        },
    ],
    certifications: [
        {
            date: "Jun 2024",
            title: "Certification of Training",
            about: "Data Entry",
            subtitle: "ProVA",
        },
        {
            date: "Apr 2026",
            title: "Certificate of Publication",
            about: "Publication of Study",
            subtitle: "IJCSMC",
        },
        {
            date: "Jul 2026",
            title: "Certificate of Completion",
            about: "Anti-Money Laundering Council (AMLC) Training",
            subtitle: "iProcess",
        },
    ],
    development: [
        {
            date: "Sept 2025",
            title: "AI.DEAS for Impact Participant",
            subtitle: "DICT Negros Occidental",
        },
        {
            date: "Oct 2024",
            title: "Victorias in Motion Seminar",
            subtitle: "DTI Negros Occidental",
        },
    ],
};

const tabs = [
    { key: "education", label: "education" },
    { key: "certifications", label: "certifications" },
    { key: "development", label: "professional development" },
];
---

<section
    id="credentials"
    class="relative bg-white text-black px-6 py-24 md:px-16 md:py-32 border-t border-neutral-200"
>
    <span
        data-cred-el
        class="block font-mono text-[11px] tracking-wide text-neutral-400 mb-14 text-center md:text-left"
    >
        07 / credentials
    </span>

    <div class="max-w-3xl mx-auto">
        <div
            class="flex flex-wrap justify-center gap-x-8 gap-y-3 mb-10 border-b border-neutral-200 pb-6"
        >
            {
                tabs.map((t, i) => (
                    <button
                        data-cred-tab
                        data-key={t.key}
                        aria-current={i === 0 ? "true" : "false"}
                        class="relative font-mono text-xs tracking-wide text-neutral-400 aria-current:text-black transition-colors duration-200 pb-1"
                    >
                        {t.label}
                        <span
                            data-cred-tab-line
                            class="absolute left-0 -bottom-6.25 h-px w-full bg-black origin-left"
                            style={i === 0 ? "" : "transform: scaleX(0);"}
                        />
                    </button>
                ))
            }
        </div>

        <div data-cred-list class="overflow-hidden">
            <div data-cred-inner>
                {
                    Object.entries(data).map(([key, items], groupIndex) => (
                        <div
                            data-cred-panel
                            data-key={key}
                            style={groupIndex === 0 ? "" : "display:none;"}
                        >
                            {items.map((item) => (
                                <div class="group flex flex-col md:flex-row md:items-start gap-3 md:gap-8 py-6 border-b border-neutral-100 last:border-b-0">
                                    <!-- Date Column -->
                                    <span class="font-mono text-xs text-neutral-400 md:w-28 shrink-0 pt-1">
                                        {item.date}
                                    </span>
                                    
                                    <!-- Title & About Column -->
                                    <div class="flex-1">
                                        <h4 class="text-lg md:text-xl tracking-tight text-black font-medium">
                                            {item.title}
                                        </h4>
                                        {item.about && (
                                            <p class="text-sm text-neutral-600 mt-1.5 leading-relaxed max-w-md">
                                                {item.about}
                                            </p>
                                        )}
                                    </div>
                                    
                                    <!-- Subtitle/Organization Column -->
                                    <span class="text-sm text-neutral-500 md:text-right md:ml-auto pt-1">
                                        {item.subtitle}
                                    </span>
                                </div>
                            ))}
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    const section = document.querySelector("#credentials");
    const label = section?.querySelector<HTMLElement>("[data-cred-el]");
    const tabs = section
        ? gsap.utils.toArray<HTMLButtonElement>("[data-cred-tab]", section)
        : [];
    const list = section?.querySelector<HTMLElement>("[data-cred-list]");
    const panels = section
        ? gsap.utils.toArray<HTMLElement>("[data-cred-panel]", section)
        : [];

    if (label) {
        gsap.set(label, {
            opacity: prefersReducedMotion ? 1 : 0,
            y: prefersReducedMotion ? 0 : 12,
        });
        if (!prefersReducedMotion) {
            gsap.to(label, {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: section,
                    start: "top 85%",
                    once: true,
                },
            });
        }
    }

    gsap.set(panels, {
        opacity: prefersReducedMotion ? 1 : 0,
        y: prefersReducedMotion ? 0 : 16,
    });
    if (!prefersReducedMotion) {
        gsap.to(panels, {
            opacity: 1,
            y: 0,
            duration: 0.6,
            ease: "power3.out",
            scrollTrigger: { trigger: section, start: "top 75%", once: true },
        });
    }

    function switchTab(activeKey: string) {
        const activePanel = panels.find((p) => p.dataset.key === activeKey);
        const currentPanel = panels.find((p) => p.style.display !== "none");
        if (!activePanel || activePanel === currentPanel || !list) return;

        tabs.forEach((tab) => {
            const isActive = tab.dataset.key === activeKey;
            tab.setAttribute("aria-current", String(isActive));
            const line = tab.querySelector("[data-cred-tab-line]");
            if (line)
                gsap.to(line, {
                    scaleX: isActive ? 1 : 0,
                    duration: 0.3,
                    ease: "power2.out",
                });
        });

        if (prefersReducedMotion) {
            panels.forEach(
                (p) => (p.style.display = p === activePanel ? "" : "none"),
            );
            return;
        }

        const startHeight = list.offsetHeight;

        if (currentPanel) currentPanel.style.display = "none";
        activePanel.style.display = "";
        const endHeight = activePanel.offsetHeight;
        activePanel.style.display = "none";
        if (currentPanel) currentPanel.style.display = "";

        gsap.set(list, { height: startHeight });

        const tl = gsap.timeline();

        if (currentPanel) {
            tl.to(currentPanel, {
                opacity: 0,
                y: -8,
                duration: 0.25,
                ease: "power2.in",
                onComplete: () => {
                    currentPanel.style.display = "none";
                },
            });
        }

        tl.to(
            list,
            {
                height: endHeight,
                duration: 0.4,
                ease: "power2.inOut",
            },
            currentPanel ? "-=0.05" : 0,
        )
            .set(activePanel, { display: "", opacity: 0, y: 8 })
            .to(activePanel, {
                opacity: 1,
                y: 0,
                duration: 0.35,
                ease: "power3.out",
            })
            .set(list, { height: "auto" });
    }

    tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
            if (tab.dataset.key) switchTab(tab.dataset.key);
        });
    });
</script>

<style>
    [data-cred-el] {
        opacity: 1;
    }
</style>