---
// src/components/Services.astro
const services = [
    {
        num: "01",
        name: "Custom Website Development",
        desc: "Fast, modern personal and company websites designed to build a strong online presence and attract more customers.",
    },
    {
        num: "02",
        name: "Business Systems & Portals",
        desc: "Custom web applications, client portals, and online tools that help growing businesses manage operations smoothly.",
    },
    {
        num: "03",
        name: "Website Optimization & Speed",
        desc: "Speed up slow websites, improve mobile responsiveness, and fix technical bugs so visitors enjoy a seamless experience.",
    },
    {
        num: "04",
        name: "Data Operations & Virtual Support",
        desc: "Accurate data entry, spreadsheet management, appointment scheduling, and organized digital document tracking.",
    },
];
---

<section
    id="services"
    class="relative bg-white text-black px-6 py-24 md:px-16 md:py-32 border-t border-neutral-200"
>
    <span
        data-services-el
        class="block font-mono text-[11px] tracking-wide text-neutral-400 mb-16"
    >
        02 / services
    </span>

    <div class="max-w-5xl mx-auto">
        {
            services.map((s) => (
                <div
                    data-services-row
                    class="group relative flex flex-col md:flex-row md:items-baseline gap-4 md:gap-8 py-8 border-b border-neutral-200 cursor-default"
                >
                    <!-- Number -->
                    <span class="font-mono text-xs text-neutral-400 md:w-12 shrink-0 pt-1">
                        {s.num}
                    </span>

                    <!-- Service Name -->
                    <span class="text-2xl md:text-4xl font-medium tracking-tight md:w-1/2 shrink-0">
                        {s.name}
                    </span>

                    <!-- Description -->
                    <span class="text-sm md:text-base text-neutral-500 md:ml-auto max-w-sm leading-relaxed">
                        {s.desc}
                    </span>

                    <!-- Hover Arrow -->
                    <span
                        data-services-arrow
                        class="hidden md:inline-block text-xl text-neutral-300 absolute right-0 top-1/2 -translate-y-1/2 opacity-0 translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ease-out"
                        aria-hidden="true"
                    >
                        ↗
                    </span>

                    <!-- Scroll-linked Underline -->
                    <span
                        data-services-line
                        class="absolute left-0 bottom-0 h-px w-full bg-black origin-left scale-x-0"
                    />
                </div>
            ))
        }
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    const section = document.querySelector<HTMLElement>("#services");
    const label = section?.querySelector<HTMLElement>("[data-services-el]");
    const rows = section
        ? gsap.utils.toArray<HTMLElement>("[data-services-row]", section)
        : [];

    if (prefersReducedMotion || rows.length === 0) {
        gsap.set([label, ...rows], { opacity: 1, y: 0 });
        rows.forEach((row) => {
            const line = row.querySelector<HTMLElement>("[data-services-line]");
            if (line) gsap.set(line, { scaleX: 1 });
        });
    } else {
        // 1. Simple fade-in for the section label
        if (label) {
            gsap.set(label, { opacity: 0, y: 12 });
            gsap.to(label, {
                opacity: 1,
                y: 0,
                duration: 0.6,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: section,
                    start: "top 85%",
                    once: true,
                },
            });
        }

        // 2. Scroll-linked (Scrub) Animation ONLY for the underline
        rows.forEach((row) => {
            const line = row.querySelector<HTMLElement>("[data-services-line]");

            if (line) {
                // Start with the line hidden
                gsap.set(line, { scaleX: 0 });
                
                // Draw the line based on scroll position
                gsap.to(line, {
                    scaleX: 1,
                    duration: 1,
                    ease: "none", // "none" ensures it tracks the scroll wheel 1:1
                    scrollTrigger: {
                        trigger: row,
                        start: "top 80%", // Starts drawing when the row enters the lower viewport
                        end: "top 40%",   // Finishes drawing as it reaches the middle
                        scrub: 1,         // 1-second smoothing lag for a premium, fluid feel
                    },
                });
            }
        });
    }
</script>

<style>
    [data-services-el] {
        opacity: 1;
    }
</style>